<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/white"
    android:elevation="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Início -->
    <LinearLayout
        android:id="@+id/nav_inicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/icon_inicio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            app:tint="@color/nav_item_color"
            android:duplicateParentState="true"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/text_inicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Início"
            android:textSize="12sp"
            android:textColor="@color/nav_item_color"
            android:duplicateParentState="true"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Pedidos -->
    <LinearLayout
        android:id="@+id/nav_pedidos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/icon_pedidos"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_receipt"
            app:tint="@color/nav_item_color"
            android:duplicateParentState="true"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/text_pedidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pedidos"
            android:textSize="12sp"
            android:textColor="@color/nav_item_color"
            android:duplicateParentState="true"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Ofertas -->
    <LinearLayout
        android:id="@+id/nav_ofertas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/icon_ofertas"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_offer"
            app:tint="@color/nav_item_color"
            android:duplicateParentState="true"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/text_ofertas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ofertas"
            android:textSize="12sp"
            android:textColor="@color/nav_item_color"
            android:duplicateParentState="true"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Perfil -->
    <LinearLayout
        android:id="@+id/nav_perfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/icon_perfil"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person"
            app:tint="@color/nav_item_color"
            android:duplicateParentState="true"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/text_perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil"
            android:textSize="12sp"
            android:textColor="@color/nav_item_color"
            android:duplicateParentState="true"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
