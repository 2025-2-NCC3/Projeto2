<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Opcional (algumas libs checam o estado de rede) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_logo_circulo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_logo_circulo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia"

    android:usesCleartextTraffic="true"
    android:networkSecurityConfig="@xml/network_security_config"
    >

    <!-- Splash como ÚNICA launcher -->
    <activity
        android:name=".SplashActivity"
        android:exported="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

    <!-- Demais telas -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia" />

    <activity
        android:name=".HomeActivity"
        android:exported="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia" />

    <activity
        android:name=".LoginActivity"
        android:exported="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia" />

    <activity
        android:name=".SignupActivity"
        android:exported="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia" />

    <activity
        android:name=".ForgotPassword"
        android:exported="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia" />

    <activity
        android:name=".WelcomeActivity"
        android:exported="true"
        android:theme="@style/Theme.AplicativoComedoriaDaTia" />

    <activity
        android:name=".ProductDetailsActivity"
        android:exported="false"
        android:theme="@style/Theme.AplicativoComedoriaDaTia" />

        <activity
            android:name=".CartActivity"
            android:exported="false"
            android:theme="@style/Theme.AplicativoComedoriaDaTia" />

        <activity android:name=".OffersActivity"
            android:exported="false"
            android:theme="@style/Theme.AplicativoComedoriaDaTia"/>
        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            />

        <activity android:name=".AllProductsActivity"
            android:exported="false"
            android:theme="@style/Theme.AplicativoComedoriaDaTia"/>




</application>
    </manifest>
