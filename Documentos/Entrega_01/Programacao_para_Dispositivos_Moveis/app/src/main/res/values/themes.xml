<resources>

    <!-- Tema base fixo (claro) -->
    <style name="Base.Theme.AplicativoComedoriaDaTia" parent="Theme.Material3.Light.NoActionBar">
        <!-- Cores principais -->
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSecondary">@color/green</item>
    </style>

    <!-- Tema principal -->
    <style name="Theme.AplicativoComedoriaDaTia" parent="Base.Theme.AplicativoComedoriaDaTia" />

    <!-- Tema da Splash -->
    <style name="Theme.AplicativoComedoriaDaTia.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@drawable/background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_logo_circulo</item>
        <item name="postSplashScreenTheme">@style/Theme.AplicativoComedoriaDaTia</item>
    </style>

</resources>