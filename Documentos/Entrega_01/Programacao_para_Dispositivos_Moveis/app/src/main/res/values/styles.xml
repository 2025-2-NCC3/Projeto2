<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shapes -->
    <style name="ShapeAppearanceOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Rounded28">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
        <!-- Para pill perfeito:
        <item name="cornerSize">50%</item>
        -->
    </style>

    <!-- Botões base -->
    <style name="Widget.App.RoundedButton.Filled" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Rounded28</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.RoundedButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Rounded28</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Alias: Outline (compatível com seu layout) -->
    <style name="Widget.App.RoundedButton.Outline" parent="Widget.App.RoundedButton.Outlined" />

    <!-- Verdes -->
    <style name="Widget.App.RoundedButton.GreenFilled" parent="Widget.App.RoundedButton.Filled">
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/green</item>
    </style>

    <style name="Widget.App.RoundedButton.GreenOutlined" parent="Widget.App.RoundedButton.Outlined">
        <item name="strokeColor">@color/green</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/green</item>
        <item name="iconTint">@color/green</item>
        <item name="rippleColor">@color/green</item>
    </style>

    <!-- Cartão do login - agora branco com borda sutil -->
    <style name="Widget.App.LoginCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:background">@color/card_glass</item>
        <item name="cardForegroundColor">@android:color/transparent</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">10dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_border</item>
    </style>

</resources>
